      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zahlungs-QR erzeugen“ erscheint im Rechtsklick-Menü unter „Dienste“, sobald die App einmal aus dem Programme-Ordner gestartet wurde. Fehlt der Eintrag, hilft ein Neustart des Finders oder `pbs -flush`."
          }
        }
      }
    },
